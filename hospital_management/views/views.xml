<odoo>
    <data>
        <!-- List View -->
        <record id="view_hospital_patient_tree" model="ir.ui.view">
            <field name="name">hospital.patient.list</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="name"/>
                    <field name="age"/>
                    <field name="gender"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hospital_patient_form" model="ir.ui.view">
            <field name="name">hospital.patient.form</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                            </group>
                            <group>
                                <field name="gender"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_hospital_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hospital.patient</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Top-level and sub-menus -->
        <menuitem id="menu_hospital_root" name="Hospital Management" sequence="10"/>
        <menuitem id="menu_hospital_patients" name="Patients" parent="menu_hospital_root" action="action_hospital_patient" sequence="10"/>
    </data>
</odoo>
