<odoo>
    <record id="view_retail_product_form" model="ir.ui.view">
        <field name="name">retail.product.form</field>
        <field name="model">retail.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>

                        <field name="name"/>

                        <field name="sku"/>

                        <field name="available_quantity" readonly="1"/>

                        <field name="sale_price"/>

                        <field name="cost_price"/>

                        <field name="currency_id" invisible="1"/>

                        <field name="active"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retail_product_list" model="ir.ui.view">
        <field name="name">retail.product.list</field>
        <field name="model">retail.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>

                <field name="sku"/>

                <field name="available_quantity" readonly="1"/>

                <field name="currency_id" colum n_invisible="1"/>

                <field name="sale_price"/>

                <field name="cost_price"/>

                <field name="active"/>

            </list>
        </field>
    </record>

    <record id="view_retail_product_kanban" model="ir.ui.view">
    <field name="name">retail.product.kanban</field>
    <field name="model">retail.product</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">

            <field name="name"/>

            <field name="sku"/>

            <field name="available_quantity"/>

            <field name="sale_price"/>

            <field name="cost_price"/>

            <field name="currency_id"/>

            <field name="active"/>


            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>
                                <field name="name"/>
                            </strong>

                            <field
                                name="active"
                                widget="boolean_button"
                            />
                        </div>

                        <div class="text-muted">
                            SKU:
                            <field name="sku"/>
                        </div>

                        <div class="mt-3">
                            <span class="text-muted">Available Stock</span>
                            <h4 class="text-primary mb-0">
                                <field name="available_quantity"/>
                            </h4>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <span>
                                Selling Price:
                                <field name="sale_price"/>
                            </span>
                        </div>

                        <div class="text-muted mt-2">
                            Cost Price:
                            <field name="cost_price"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="action_retail_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">retail.product</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        id="menu_retail_product"
        name="Products"
        parent="menu_retail_shop"
        action="action_retail_product"
        sequence="1"/>
</odoo>