<odoo>
    <record id="view_retail_sale_tag_list" model="ir.ui.view">
        <field name="name">retail.sale.tag.list</field>
        <field name="model">retail.sale.tag</field>
        <field name="arch" type="xml">
            <list string="Sale Tags">
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_retail_sale_tag_form" model="ir.ui.view">
        <field name="name">retail.sale.tag.form</field>
        <field name="model">retail.sale.tag</field>
        <field name="arch" type="xml">
            <form string="Sale Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retail_sale_tag" model="ir.actions.act_window">
        <field name="name">Sale Tags</field>
        <field name="res_model">retail.sale.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_retail_sale_tag"
        name="Sale Tags"
        parent="menu_retail_shop"
        action="action_retail_sale_tag"
        sequence="10"/>
</odoo>