<odoo>
    <record id="view_sale_form" model="ir.ui.view">
        <field name="name">Sale.form</field>
        <field name="model">retail.sale</field>
        <field name="arch" type="xml">
            <form string="Sale">
            <header>
                <button
                    name="action_confirm"
                    string="Confirm"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'draft'"/>

                <button
                    name="action_cancel"
                    string="Cancel"
                    type="object"
                    class="btn-secondary"
                    invisible="state == 'cancelled'"/>

                <button
                    name="action_reset_to_draft"
                    string="Reset to Draft"
                    type="object"
                    class="btn-secondary"
                    invisible="state != 'cancelled'"/>

                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="draft,confirmed,cancelled"/>
            </header>
                <sheet>
                    <group>
                        <field name="product_id" readonly="state != 'draft'"/>
                        <field name="customer_id" readonly="state != 'draft'"/>
                        <field name="date" readonly="state != 'draft'"/>
                        <field name="quantity" readonly="state != 'draft'"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price" readonly="state != 'draft'"/>
                        <field name="discount" readonly="state != 'draft'"/>
                        <field name="total_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retail_sale_kanban" model="ir.ui.view">
    <field name="name">retail.sale.kanban</field>
    <field name="model">retail.sale</field>
    <field name="arch" type="xml">
        <kanban
            default_group_by="state"
            class="o_kanban_small_column"
            records_draggable="true">

            <field name="name"/>
            <field name="state"/>
            <field name="product_id"/>
            <field name="customer_id"/>
            <field name="date"/>
            <field name="quantity"/>
            <field name="discount"/>
            <field name="total_amount"/>
            <field name="currency_id"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>
                                <field name="name"/>
                            </strong>

                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'draft'"
                                decoration-success="state == 'confirmed'"
                                decoration-danger="state == 'cancelled'"
                            />
                        </div>

                        <div class="mb-2">
                            <strong>Product:</strong>
                            <field name="product_id"/>
                        </div>

                        <div class="text-muted">
                            <strong>Customer:</strong>
                            <field name="customer_id"/>
                        </div>

                        <div class="text-muted">
                            <strong>Date:</strong>
                            <field name="date"/>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <span>
                                Quantity:
                                <strong><field name="quantity"/></strong>
                            </span>

                            <span>
                                Discount:
                                <strong><field name="discount"/>%</strong>
                            </span>
                        </div>

                        <div class="mt-3">
                            <span class="text-muted">Total</span>
                            <h4 class="text-primary mb-0">
                                <field name="total_amount"/>
                            </h4>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="view_retail_sale_graph" model="ir.ui.view">
    <field name="name">retail.sale.graph</field>
    <field name="model">retail.sale</field>
    <field name="arch" type="xml">
        <graph string="Sales Analysis" type="bar">
            <field name="date" interval="month" type="row"/>
            <field name="total_amount" type="measure"/>
        </graph>
    </field>
    </record>

    <record id="action_sale" model="ir.actions.act_window">
        <field name="name">Sale</field>
        <field name="res_model">retail.sale</field>
        <field name="view_mode">kanban,list,graph,form</field>
    </record>

    <menuitem
        id="menu_sale"
        name="Sale"
        parent="menu_retail_shop"
        action="action_sale"
        sequence="2"/>
</odoo>
