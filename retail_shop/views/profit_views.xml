<odoo>
    <record id="view_profit_form" model="ir.ui.view">
        <field name="name">profit.form</field>
        <field name="model">retail.profit</field>
        <field name="arch" type="xml">
            <form string="Profit">
                <sheet>
                    <group>

                        <field name="sale_id"/>

                        <field name="date"/>

                        <field name="currency_id" invisible="1"/>

                        <field name="profit_amount" readonly="1"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_profit_list" model="ir.ui.view">
        <field name="name">profit.list</field>
        <field name="model">retail.profit</field>
        <field name="arch" type="xml">

            <list string="Profit">

                <field name="sale_id"/>

                <field name="currency_id" column_invisible="1"/>

                <field name="profit_amount"/>

                <field name="date"/>

            </list>

        </field>

    </record>

    <record id="view_retail_profit_kanban" model="ir.ui.view">
    <field name="name">retail.profit.kanban</field>
    <field name="model">retail.profit</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">
            <field name="sale_id"/>
            <field name="date"/>
            <field name="profit_amount"/>
            <field name="currency_id"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Profit Record</strong>
                            <field name="date"/>
                        </div>

                        <div class="text-muted">
                            Sale:
                            <field name="sale_id"/>
                        </div>

                        <div class="mt-3">
                            <span class="text-muted">Profit</span>
                            <h4 class="text-success mb-0">
                                <field name="profit_amount"/>
                            </h4>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="action_profit" model="ir.actions.act_window">
        <field name="name">Profit</field>
        <field name="res_model">retail.profit</field>
        <field name="view_mode">kanban,list,graph,form</field>
    </record>

    <menuitem
        id="menu_profit"
        name="Profit"
        parent="menu_retail_shop"
        sequence="3"
        action="action_profit"/>
</odoo>
