<odoo>
    <record id="view_profit_form" model="ir.ui.view">
        <field name="name">profit.form</field>
        <field name="model">retail.profit</field>
        <field name="arch" type="xml">
            <form string="Profit">
                <sheet>
                    <group>
                        <field name="sale_id"/>
                        <field name="date"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="profit_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_profit_list" model="ir.ui.view">
        <field name="name">profit.list</field>
        <field name="model">retail.profit</field>
        <field name="arch" type="xml">
            <list string="Profit">
                <field name="sale_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="profit_amount"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_retail_profit_kanban" model="ir.ui.view">
    <field name="name">retail.profit.kanban</field>
    <field name="model">retail.profit</field>
    <field name="arch" type="xml">
        <kanban>
            <field name="sale_id"/>
            <field name="profit_amount"/>
            <field name="date"/>
            <field name="currency_id"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card">
                        <strong><field name="sale_id"/></strong>
                        <div>Date: <field name="date"/></div>
                        <div>Profit: <field name="profit_amount"/></div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="action_profit" model="ir.actions.act_window">
        <field name="name">Profit</field>
        <field name="res_model">retail.profit</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem
        id="menu_profit"
        name="Profit"
        parent="menu_retail_shop"
        sequence="3"
        action="action_profit"/>
</odoo>
