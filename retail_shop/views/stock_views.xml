<odoo>
    <record id="view_stock_form" model="ir.ui.view">
        <field name="name">stock.form</field>
        <field name="model">retail.stock</field>
        <field name="arch" type="xml">
            <form string="Stock">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="date"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_list" model="ir.ui.view">
        <field name="name">stock.list</field>
        <field name="model">retail.stock</field>
        <field name="arch" type="xml">
            <list string="Stock">
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="view_retail_stock_kanban" model="ir.ui.view">
    <field name="name">retail.stock.kanban</field>
    <field name="model">retail.stock</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">
            <field name="product_id"/>
            <field name="quantity"/>
            <field name="price"/>
            <field name="currency_id"/>
            <field name="date"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>
                                <field name="product_id"/>
                            </strong>
                            <field name="date"/>
                        </div>

                        <div class="mt-3">
                            <span class="text-muted">Quantity</span>
                            <h4 class="text-primary mb-0">
                                <field name="quantity"/>
                            </h4>
                        </div>

                        <div class="text-muted mt-2">
                            Unit Cost:
                            <field name="price"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="action_stock" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="res_model">retail.stock</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        id="menu_stock"
        name="Stock"
        parent="menu_retail_shop"
        action="action_stock"
        sequence="1"/>
</odoo>
